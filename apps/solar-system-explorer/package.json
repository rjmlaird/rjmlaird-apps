{
  "name": "solar-system-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o public/tailwind.css --minify",
    "build:icons": "node ../../scripts/copy-fontawesome.mjs",
    "build:assets": "pnpm run build:css && pnpm run build:icons",
    "dev": "pnpm run build:assets && vite",
    "build": "pnpm run build:assets && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@rjmlaird/brand-tokens": "workspace:*",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.21",
    "wrangler": "^4.149.0"
  }
}
