{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "astrodash",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "routes": [
    {
      "pattern": "astrodash.apps.rjmlaird.co.uk",
      "custom_domain": true
    }
  ]
}
